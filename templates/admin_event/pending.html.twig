{% extends 'base.html.twig' %}

{% block title %}Admin - Événements en attente{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold mb-4">Événements en attente de validation</h1>

    {% for key, array in app.flashes %}
        {% for message in array %}
            <p class="mb-3 p-3 border rounded bg-white"><strong>{{ key|upper }}</strong> : {{ message }}</p>
        {% endfor %}
    {% endfor %}

    {% if events is empty %}
        <p>Aucun événement en attente.</p>
    {% else %}
        <div class="grid gap-4">
            {% for e in events %}
                <div class="border rounded bg-white p-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="font-semibold">{{ e.title }}</p>
                            <p class="text-sm text-gray-600">
                                {{ e.city }} ({{ e.zipcode }}) — {{ e.region }} — {{ e.country }}
                            </p>
                            <p class="text-sm text-gray-600">
                                {{ e.eventDate|date('d/m/Y H:i') }}
                            </p>
                            <p class="mt-2">{{ e.description }}</p>
                        </div>

                        <div class="flex flex-col gap-2">
                            <a class="px-4 py-2 rounded bg-black text-white text-center"
                               href="{{ path('app_admin_event_validate', {id: e.id}) }}">
                                Valider
                            </a>

                            <a class="px-4 py-2 rounded border text-center"
                               href="{{ path('app_admin_event_delete', {id: e.id}) }}">
                                Supprimer
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
