{% extends 'base.html.twig' %}

{% block title %}{{ event.title }} - Pop Up Spot{% endblock %}

{% block body %}
    <div class="mb-6">
        <a class="text-sm underline" href="{{ path('app_event_index') }}">← Retour aux événements</a>
    </div>

    <div class="border rounded bg-white p-6">
        <div class="flex items-start justify-between gap-6">
            <div>
                <h1 class="text-2xl font-bold mb-2">{{ event.title }}</h1>

                <p class="text-gray-700 mb-4">{{ event.description }}</p>

                <p class="text-sm text-gray-600">
                    📍 {{ event.address }}, {{ event.zipcode }} {{ event.city }}, {{ event.region }}, {{ event.country }}
                </p>

                <p class="text-sm text-gray-600 mt-2">
                    🗓️ {{ event.eventDate|date('d/m/Y H:i') }}
                </p>

                <div class="flex flex-wrap gap-3 mt-6">
                    {% if event.instagram %}
                        <a class="px-4 py-2 rounded bg-black text-white"
                           target="_blank"
                           href="{{ event.instagram }}">
                            Ouvrir Instagram
                        </a>
                    {% endif %}

                    {% set mapsQuery = event.address ~ ', ' ~ event.zipcode ~ ' ' ~ event.city ~ ', ' ~ event.country %}
                    <a class="px-4 py-2 rounded border"
                       target="_blank"
                       href="https://www.google.com/maps/search/?api=1&query={{ mapsQuery|url_encode }}">
                        Itinéraire Google Maps
                    </a>
                </div>
            </div>

            {% if event.image %}
                <img class="w-56 h-56 object-cover rounded border"
                     src="{{ event.image }}"
                     alt="Image événement">
            {% endif %}
        </div>
    </div>
{% endblock %}
