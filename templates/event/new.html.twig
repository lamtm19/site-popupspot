{% extends 'base.html.twig' %}

{% block title %}Poster un événement - Pop Up Spot{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold mb-4">Poster un événement</h1>

    <div class="border rounded bg-white p-6">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="mt-4 px-4 py-2 rounded bg-black text-white" type="submit">
                Envoyer (validation admin)
            </button>
        {{ form_end(form) }}
    </div>
{% endblock %}
