{% extends 'base.html.twig' %}

{% block title %}Contact - Pop Up Spot{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-white">
    <div class="w-full max-w-lg border border-gray-200 rounded-xl p-8 shadow-sm">

        <h1 class="text-2xl font-semibold text-center mb-6">Nous contacter</h1>

        {{ form_start(form) }}

            {% if form_errors(form) %}
                <div class="mb-4 text-sm text-red-600 text-center">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="space-y-4">

                <div>
                    <label class="block text-sm font-medium mb-1" for="{{ form.email.vars.id }}">
                        Votre email
                    </label>
                    {{ form_widget(form.email, { attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2' } }) }}
                    <div class="text-sm text-red-600 mt-1">{{ form_errors(form.email) }}</div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1" for="{{ form.sujet.vars.id }}">
                        Sujet
                    </label>
                    {{ form_widget(form.sujet, { attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2' } }) }}
                    <div class="text-sm text-red-600 mt-1">{{ form_errors(form.sujet) }}</div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1" for="{{ form.contenu.vars.id }}">
                        Message
                    </label>
                    {{ form_widget(form.contenu, { attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2 h-32' } }) }}
                    <div class="text-sm text-red-600 mt-1">{{ form_errors(form.contenu) }}</div>
                </div>

                {{ form_rest(form) }}
            </div>

            <button type="submit"
                    class="mt-6 w-full bg-black text-white py-2 rounded-lg hover:bg-gray-900 transition">
                Envoyer le message
            </button>

        {{ form_end(form) }}

        <p class="mt-4 text-center text-sm text-gray-500">
            contact-popup.spot@gmail.com
        </p>

    </div>
</div>
{% endblock %}
