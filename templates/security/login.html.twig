{% extends 'base.html.twig' %}

{% block title %}Connexion - Pop Up Spot{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-white">
    <div class="w-full max-w-md border border-gray-200 rounded-xl p-8 shadow-sm">

        <h1 class="text-2xl font-semibold text-center mb-6">Connexion</h1>

        {% if error %}
            <div class="mb-4 text-sm text-red-600 text-center">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium mb-1" for="inputEmail">Email</label>
                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="email"
                        id="inputEmail"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2"
                        autocomplete="email"
                        required
                        autofocus
                    >
                </div>

                <div>
                    <label class="block text-sm font-medium mb-1" for="inputPassword">Mot de passe</label>
                    <input
                        type="password"
                        name="password"
                        id="inputPassword"
                        class="w-full border border-gray-300 rounded-lg px-3 py-2"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="flex justify-between items-center text-sm text-gray-600">
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="_remember_me">
                        <span>Se souvenir de moi</span>
                    </label>

                    <a href="{{ path('app_forgot_password_request') }}"
                       class="hover:underline hover:text-black">
                        Mot de passe oublié ?
                    </a>
                </div>
            </div>

            <button type="submit"
                    class="mt-6 w-full bg-black text-white py-2 rounded-lg hover:bg-gray-900 transition">
                Se connecter
            </button>
        </form>

        <p class="mt-4 text-center text-sm text-gray-500">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" class="underline hover:text-black">Créer un compte</a>
        </p>

    </div>
</div>
{% endblock %}
