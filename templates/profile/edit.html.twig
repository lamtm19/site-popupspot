{% extends 'base.html.twig' %}

{% block title %}Modifier mon profil - Pop Up Spot{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-white">
    <div class="w-full max-w-lg border border-gray-200 rounded-xl p-8 shadow-sm">

        <h1 class="text-2xl font-semibold text-center mb-6">Modifier mon profil</h1>

        {{ form_start(form) }}

            {% if form_errors(form) %}
                <div class="mb-4 text-sm text-red-600 text-center">
                    {{ form_errors(form) }}
                </div>
            {% endif %}

            <div class="space-y-4">
                {% for field in form %}
                    {% if field.vars.name != '_token' %}
                        <div>
                            <label class="block text-sm font-medium mb-1" for="{{ field.vars.id }}">
                                {{ field.vars.label ?? field.vars.name }}
                            </label>

                            {{ form_widget(field, {
                                attr: { class: 'w-full border border-gray-300 rounded-lg px-3 py-2' }
                            }) }}

                            <div class="text-sm text-red-600 mt-1">
                                {{ form_errors(field) }}
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}

                {{ form_rest(form) }}
            </div>

            <button type="submit"
                    class="mt-6 w-full bg-black text-white py-2 rounded-lg hover:bg-gray-900 transition">
                Enregistrer
            </button>

        {{ form_end(form) }}

        <div class="mt-4 text-center text-sm text-gray-500">
            <a href="{{ path('app_profile') }}" class="underline hover:text-black">Retour au profil</a>
        </div>

    </div>
</div>
{% endblock %}
